<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      throwExceptions="false"
      internalLogLevel="Warn"
      internalLogFile="${basedir}/logs/nlog-internal.log">

	<!-- 定义变量方便复用 -->
	<variable name="logLayout"
			  value="${longdate}|${level:uppercase=true}|${callsite:fileName=true:includeSourcePath=false:methodName=true:lineNumber=true}|${message} ${exception:format=toString}" />
	<!-- 参数说明 --><!--
	fileName=true           : 显示文件名
	includeSourcePath=false : 不包含完整路径（只显示文件名）
	methodName=true         : 显示方法名
	lineNumber=true         : 显示行号
	skipFrames=0           : 跳过多少层调用栈（0表示当前方法）
	-->
	
	<!-- 目标：定义日志输出到哪里 -->
	<targets>
		<!-- 控制台输出 - 包含行号 -->
		<target name="console" xsi:type="Console"
				layout="${logLayout}"  />

		<!-- 文件输出 - 包含行号 -->
		<target name="file" xsi:type="File"
				fileName="${basedir}/logs/${shortdate}.log"
			layout="${logLayout}"  />

	</targets>

	<!-- 规则：定义哪些日志记录到哪些目标 -->
	<rules>
		<!-- 关键修改：将级别改为 Debug 或 Trace -->
		<logger name="*" minlevel="Debug" writeTo="console,file" />

		<!-- 或者更精细的控制 -->
		<!-- <logger name="NLogTest.Person" minlevel="Trace" writeTo="console,file" /> -->
	</rules>
</nlog>