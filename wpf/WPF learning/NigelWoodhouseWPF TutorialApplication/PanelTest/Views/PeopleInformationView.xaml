<UserControl x:Class="PanelTest.Views.PeopleInformationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PanelTest.Views"
             xmlns:converter="clr-namespace:PanelTest.Converter"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <!--转换器-->
        <converter:NavigationSideToColumnGridConverter x:Key="NavigationSideToColumnGridConverter"/>

        <!--ListView的数据模板-->
        <DataTemplate x:Key="PeopleDataTemplete">
            <StackPanel Orientation="Horizontal" MaxWidth="240">
                <!--关闭数据验证-->
                <TextBlock Text="{Binding FirstName, ValidatesOnNotifyDataErrors=False}" 
                           FontWeight="Bold" Margin="0,0,5,0"/>
                <TextBlock Text="{Binding LastName}"/>
            </StackPanel>
        </DataTemplate>
        
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition/>
            <ColumnDefinition Width="auto"/>
        </Grid.ColumnDefinitions>

        <!--person选择栏-->
        <Grid Grid.Column="{Binding NavigationColumn, Converter={StaticResource NavigationSideToColumnGridConverter}}" 
              Background="Gray" Width="260">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10">
                <Button Content="Add" FontSize="15" 
                        Command="{Binding AddCommand}" />
                <Button Content="Delete" FontSize="15" 
                        Command="{Binding DeleteCommand}" />
                <Button Content="Move" FontSize="15" 
                        Command="{Binding MoveNavigationCommand}" />
            </StackPanel>
            <ListView Grid.Row="1" Margin="10,0,10,10" FontSize="15"
                      ItemsSource="{Binding People}"
                      SelectedItem="{Binding SelectedPerson, Mode=TwoWay}"
                      ItemTemplate="{StaticResource PeopleDataTemplete}"/>
        </Grid>

        <!--person设置栏-->
        <StackPanel Grid.Column="1" Margin="10" 
                    Visibility="{Binding IsPersonSelected, Converter={StaticResource ResourceKey=BooleanToVisibilityConverter}}">
            <Label FontSize="15" Content="First name:"/>
            <TextBox Text="{Binding SelectedPerson.FirstName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            <Label FontSize="15" Content="Last name:"/>
            <TextBox Text="{Binding SelectedPerson.LastName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            <CheckBox Margin="0,20,0,0" FontSize="15" 
                      IsChecked="{Binding SelectedPerson.IsDeveloper, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      Content="IsDeveloper"/>
        </StackPanel>
    </Grid>
</UserControl>
